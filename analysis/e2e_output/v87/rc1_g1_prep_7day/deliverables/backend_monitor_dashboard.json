  "alert_escalation_rules": {
    "cpu_escalation": {
      "description": "CPU usage alert escalation chain (1.9% warning -> 2.0% fuse)",
      "steps": [
        {
          "time": "T+0",
          "condition": "CPU > 1.9%",
          "alert_level": "P2",
          "action": "记录+邮件通知",
          "notify": "运维值班"
        },
        {
          "time": "T+30min",
          "condition": "CPU > 1.95% OR CPU > 1.9% sustained 30min",
          "alert_level": "P1",
          "action": "即时通知+电话",
          "notify": "技术负责人"
        },
        {
          "time": "T+60min",
          "condition": "CPU > 1.9% sustained 60min",
          "alert_level": "P1",
          "action": "准备降级",
          "notify": "技术负责人+运维主管"
        },
        {
          "time": "T+90min",
          "condition": "CPU > 1.95% sustained 90min",
          "alert_level": "P1",
          "action": "执行降级准备",
          "notify": "技术负责人+CTO"
        },
        {
          "time": "T+4h",
          "condition": "CPU > 2.0% sustained 4h",
          "alert_level": "P0",
          "action": "执行熔断降级 (DL-003)",
          "notify": "全体+CTO"
        },
        {
          "time": "T+24h",
          "condition": "CPU > 2.0% sustained 24h",
          "alert_level": "P0",
          "action": "执行回滚 (DL-004)",
          "notify": "全体+CTO"
        }
      ]
    },
    "memory_escalation": {
      "steps": [
        {"condition": "Memory > 78%", "alert_level": "P2", "action": "通知+趋势分析", "recovery": "Memory < 78% sustained > 1h"},
        {"condition": "Memory > 80% sustained > 4h", "alert_level": "P0", "action": "强制缓存清理 (DL-006)"}
      ]
    },
    "factor_drift_escalation": {
      "steps": [
        {"condition": "Factor IC/IR drift > 0.5%", "alert_level": "P2", "action": "通知+因子分析"},
        {"condition": "Factor IC/IR drift > 2.0%", "alert_level": "P0", "action": "因子降级 (DL-007)"}
      ]
    },
    "dq_escalation": {
      "steps": [
        {"condition": "DQ < 99.5%", "alert_level": "P2", "action": "通知+数据源分析"},
        {"condition": "DQ < 95%", "alert_level": "P0", "action": "数据源降级 (DL-008)"}
      ]
    },
    "crawler_escalation": {
      "steps": [
        {"condition": "Crawler availability < 100%", "alert_level": "P2", "action": "通知+爬虫检查"},
        {"condition": "Crawler availability < 95%", "alert_level": "P0", "action": "爬虫降级 (DL-009)"}
      ]
    },
    "delay_escalation": {
      "steps": [
        {"condition": "Data delay > 5min", "alert_level": "P2", "action": "通知+数据源分析"},
        {"condition": "Data delay > 15min", "alert_level": "P0", "action": "数据源切换"}
      ]
    }
  },

  "degradation_plans": [
    {
      "plan_id": "DL-001",
      "name": "CPU预警降级",
      "trigger_condition": "CPU > 1.9% sustained > 1h",
      "trigger_metric": "cpu_usage_pct",
      "trigger_value": 1.9,
      "sustain_minutes": 60,
      "actions": [
        "降低非关键计算任务并发数50%",
        "暂停报表生成任务",
        "暂停缓存预热任务"
      ],
      "recovery_condition": "CPU < 1.9% sustained > 1h",
      "expected_recovery_minutes": 120,
      "priority": "P1",
      "status": "ARMED"
    },
    {
      "plan_id": "DL-002",
      "name": "CPU高负荷降级",
      "trigger_condition": "CPU > 1.95% sustained > 30min",
      "trigger_metric": "cpu_usage_pct",
      "trigger_value": 1.95,
      "sustain_minutes": 30,
      "actions": [
        "暂停所有非关键计算任务",
        "降低核心计算频率25%",
        "恢复非关键计算至50%"
